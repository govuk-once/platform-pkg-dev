{
  // Extends the package config so CDK code is held to the same rules as src/,
  // overriding only what it genuinely needs.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    // The CDK app is bundled and run by `dev cdk:app`, never compiled by tsc,
    // so there is no dist output to produce.
    "noEmit": true,
    "rootDir": ".",
    "types": ["node", "vitest/globals"],

    // Matches how the app is actually loaded: esbuild resolves `./x.js` to x.ts.
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "include": ["."]
}
