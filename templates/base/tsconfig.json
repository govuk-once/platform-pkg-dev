{
  "extends": "@govuk-connect/dev/tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  // cdk/ has its own tsconfig (bundler module resolution, no emit); `dev typecheck`
  // checks it separately.
  "include": ["src/**/*", "packages/**/*"],
  "exclude": ["node_modules", "dist"]
}
